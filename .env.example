GEMINI_API_KEY=your_gemini_api_key_here

# Image analysis
ANALYSE_MODEL_PRIMARY=gemini-2.5-flash-lite
ANALYSE_MODEL_FALLBACK=gemini-3.1-flash-lite

# Jewellery matching
MATCH_MODEL_PRIMARY=gemini-2.5-pro
MATCH_MODEL_FALLBACK=gemini-2.5-flash-lite

# Session logger — imgbb upload + Sheets row per session.
# GOOGLE_SERVICE_ACCOUNT_JSON must be the full service-account JSON as a
# SINGLE-LINE string (no actual newlines — \n inside private_key stays
# as the two literal characters). The target Sheet must be shared with
# the service account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
SHEETS_ID=your_google_sheets_id_here
IMGBB_API_KEY=your_imgbb_api_key_here
